{
  "entities": {
    "CaseStudy": {
      "title": "Case Study",
      "description": "A freelancing project case study",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "client": { "type": "string" },
        "challenge": { "type": "string" },
        "solution": { "type": "string" },
        "results": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "client", "challenge", "solution", "results", "tags", "createdAt"]
    },
    "ProfileData": {
      "title": "Profile Data",
      "description": "Freelance profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "headline": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "pricing": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "platform", "headline", "bio", "skills", "pricing", "createdAt"]
    },
    "BrandingAsset": {
      "title": "Branding Asset",
      "description": "AI generated branding content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["banner", "profile-pic", "social-post", "video"] },
        "url": { "type": "string" },
        "prompt": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "type", "url", "prompt", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/caseStudies/{caseStudyId}": {
      "schema": "CaseStudy",
      "description": "Collection of case studies"
    },
    "/profiles/{profileId}": {
      "schema": "ProfileData",
      "description": "Collection of user profiles"
    },
    "/brandingAssets/{assetId}": {
      "schema": "BrandingAsset",
      "description": "Collection of branding assets"
    }
  }
}
